          "_name": "social-buttons3",
          "_sourceTheme": "mobirise4",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Social\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"SocialLikes,Socicon\">\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Square Icons\" name=\"squareIcons\">\n        <header>It will share the current page</header>\n        <input type=\"checkbox\" title=\"Facebook\" name=\"facebook\">\n        <input type=\"checkbox\" title=\"Twitter\" name=\"twitter\">\n        <input type=\"checkbox\" title=\"Vkontakte\" name=\"vkontakte\" checked>\n        <input type=\"checkbox\" title=\"Odnoklassniki\" name=\"odnoklassniki\" checked>\n        <input type=\"checkbox\" title=\"Pinterest\" name=\"pinterest\" checked>\n        <input type=\"checkbox\" title=\"Mailru\" name=\"mailru\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"../_images/background4.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffe161\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"media-container-row\">\n            <div class=\"col-md-8 align-center\">\n</div></div></div>&nbsp;\n<div style=\"width: 800px; margin: 0 auto; text-align: center;\">\n  <h1 style=\"text-align: center;\">\n    <b>\n      <span style=\"font-family: Merriweather;\">\n        <span style=\"color: red;\">☑</span>&nbsp;\n        <span style=\"color: red;\">On</span>\n        <span style=\"color: #01ffff;\">лайн радио</span>\n      </span>\n    </b>\n  </h1>\n  <div id=\"radiobells_container\">\n    <a href=\"https://www.radiobells.com/\" rel=\"nofollow\" id=\"RP_link\">Онлайн радио</a> #radiobells_script_hash\n  </div>\n  <link href=\"https://www.radiobells.com/script/style.css\" type=\"text/css\" rel=\"stylesheet\">\n  [JS_CODE_0]\n  [JS_CODE_1]\n</div><br /><br />\n<style>\n  /* Общий стиль для всей области текста с тенью */\n  .text-with-shadow {\n    text-shadow: 0px 1px #000;\n  }\n</style>\n<div class=\"text-with-shadow\">\n<h1 style=\"text-align: center;\">\n<span style=\"color: red; font-family: Playfair Display; font-size: large;\">\n<center>\n</center></span></h1>\n<div style=\"text-align: center;\">\n<span style=\"color: red; font-family: Playfair Display; font-size: large;\"><b>\n<div style=\"width:300px;height:300px;margin:0 auto\">\n[JS_CODE_2]\n<div class=\"ya-share2\" data-curtain data-size=\"l\" data-shape=\"round\" data-services=\"vkontakte,odnoklassniki,telegram,moimir,blogger\">\n</div>\n</div></span></div></div></section>",
